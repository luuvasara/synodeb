#!/bin/sh
# synodeb installer, preseed/early_command. The DS923+ has no screen: the front panel
# tells what is going on and the DOM falls back to DSM unless the installation completes.
#  - power LED on, status LED green blinking, fans at a fixed 50 %;
#  - the DOM default goes back to the Synology entry right away, so any failure or reboot
#    before the end of the installation starts DSM again (finish makes DEBIAN the default);
#  - mdadm never assembles arrays found on the disks (DSM's included): only the ones
#    created in the partitioner exist in the installer;
#  - one long beep when SSH is ready; no SSH within 20 minutes (no network): three beeps
#    and a reboot into DSM.
# The background part must not keep any descriptor of the installer open (debconf talks on
# fd 3): the installer would wait for it forever.
. /usr/lib/synodeb-installer/lib.sh
# once only (the installer runs early_command again after loading a preseed file from the network)
[ ! -e /run/synodeb-early ] || exit 0
: > /run/synodeb-early
mkdir -p /etc/mdadm
printf '%s\n' '# synodeb installer: never assemble arrays found on the disks' 'AUTO -all' > /etc/mdadm/mdadm.conf
(
    up V50 4 9
    i=0
    while [ $i -lt 30 ] && ! dom_default SYNOLOGY_2; do sleep 2; i=$((i + 1)); done
    i=0
    while [ $i -lt 600 ]; do
        if pidof sshd >/dev/null 2>&1 || pidof sshd-session >/dev/null 2>&1; then
            log "SSH is ready"
            up 3
            exit 0
        fi
        sleep 2; i=$((i + 1))
    done
    log "no SSH after 20 minutes: rebooting into DSM"
    up 3 2 3 2 3
    sleep 5
    reboot
) </dev/null >/dev/null 2>&1 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
exit 0
