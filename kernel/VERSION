# synodeb kernel: upstream version (kernel.org tarball: 7.3, 7.3.1, ...) and ABI number.
# The kernel is named <upstream x.y.z>-<ABI>-ds923 (e.g. 7.3.0-1-ds923, package
# linux-image-7.3.0-1-ds923). ABI is bumped on every published build, so the previous
# kernel stays installed next to the new one and serves as DEBIAN_OLD on the DOM.
# .github/workflows/kernel.yml updates KVER and ABI when a new 7.3.y stable release is out.
KVER=7.3
ABI=1
# derived
KUPS=$KVER; case $KUPS in *.*.*) ;; *) KUPS=$KUPS.0 ;; esac
KREL=$KUPS-$ABI-ds923           # uname -r
KPKGVER=$KUPS-$ABI              # version of the .deb packages
