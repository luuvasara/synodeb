# Synology DS2415+ — fragment merged after ds923.config and ds923-slim.config, only when
# build-kernel.sh is given it (EXTRA_CONFIGS="ds2415p.config"); without it the DS923+ .config
# is exactly what it was. "ds2415p" = DS2415+: Synology also sells non-plus models in this
# family (DS1515 and DS1515+ are different hardware), DSM itself spells it DS2415p.
# Bay LEDs (88SE9215 GPIO + Avoton GPIO 49) and the DX1215 expansion unit (patch 0010):
# a module, loaded by modules-load.d; it binds only on the DS2415+ board (DMI + PCI topology)
CONFIG_SYNOLOGY_DS2415P=m
# selected by SYNOLOGY_DS2415P (patch 0009): PMP vendor registers from a quiet EH round
CONFIG_SATA_PMP_VENDOR_EH=y
# DS2415+ hardware (already y/m in Debian, restated)
CONFIG_SATA_PMP=y
CONFIG_SATA_AHCI=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_DRIVETEMP=m
CONFIG_IGB=m
# rtc_cmos is the only RTC on this board: it stays the module ds923.config makes it
# (autoloaded for PNP0B00) and the DS2415+ package does not blacklist it
CONFIG_RTC_DRV_CMOS=m
# MCU on the legacy 16550 at 0x2F8 (ttyS1)
CONFIG_SERIAL_8250=y
# gpio-ich must stay off: its output cache starts at 0 and its first write would clear the
# other SUS-well outputs; the driver writes GPIO 49 itself (one byte, read-modify-write)
# CONFIG_GPIO_ICH is not set
