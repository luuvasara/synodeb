[Unit]
Description=Synology DS923+ hardware daemon (fan, LEDs, buttons, beep)
After=systemd-modules-load.service systemd-udevd.service
Wants=systemd-modules-load.service
# microcontroller UART in the ACPI tables (absent in QEMU and on other machines)
ConditionPathExists=/sys/bus/acpi/devices/AMDI0020:01
# fans and LEDs also in UPS Safe Mode (synodeb-ups-safe.target)
IgnoreOnIsolate=yes

[Service]
Type=simple
ExecStart=/usr/sbin/synohwd run
Restart=always
RestartSec=3
# with the daemon stopped the fan stays at its last duty: better full speed
ExecStopPost=/bin/sh -c 'stty -F /dev/synology-up 115200 raw -echo 2>/dev/null; printf V99 > /dev/synology-up || true'

[Install]
WantedBy=multi-user.target
